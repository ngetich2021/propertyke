# Copy to .env for local dev, and set the same names (with real values) in
# your hosting platform's environment variables for deployment. See the
# comment on each var for where it's used and what changes between
# environments.

# --- Auth (Auth.js v5 / next-auth beta) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Only needed if you want to force the callback URL (e.g. behind a proxy
# that doesn't set forwarded-host headers correctly). On Vercel this is
# auto-detected from the request -- leave unset there. Locally, keep it as
# your dev URL. If you do set it in production, it MUST be your real
# deployed URL, never localhost.
NEXTAUTH_URL=http://localhost:3000

# Auth.js v5 only auto-trusts the request host on Vercel. Deploying anywhere
# else (Render, Railway, Fly, a plain Docker host, etc.) needs this set to
# "true" or sign-in fails with an UntrustedHost error. Leave unset on Vercel.
# AUTH_TRUST_HOST=true

# Google OAuth client -- console.cloud.google.com -> APIs & Services ->
# Credentials. Its "Authorized redirect URIs" must include
# <your-deployed-url>/api/auth/callback/google (in addition to the
# localhost one used for dev) or sign-in will fail with redirect_uri_mismatch.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Image uploads (listing photos, ad media) ---
# cloudinary.com dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Outgoing email (admin/listing notifications) ---
# A Gmail App Password (myaccount.google.com/apppasswords), not the account
# password -- requires 2FA enabled on the Gmail account.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Database (Turso/libsql) -- this is the real runtime database ---
TURSO_AUTH_TOKEN=
TURSO_DATABASE_URL=

# Local SQLite file used only by `prisma generate`/`prisma migrate diff`
# (schema authoring & diffing tools -- see prisma.config.ts) -- the app
# itself never connects to this at runtime, it uses TURSO_DATABASE_URL
# above via lib/prisma.ts. Safe to leave as-is everywhere, including on
# your hosting platform.
DATABASE_URL="file:./dev.db"

# --- M-Pesa (Safaricom Daraja) ---
# "sandbox" for testing against Safaricom's sandbox, "production" for real
# money via your live till.
MPESA_ENV=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TILL_NUMBER=
# Must be a real, publicly reachable HTTPS URL Safaricom can POST to --
# <this>/api/mpesa/callback is where STK push results land (see
# app/api/mpesa/callback/route.ts). An ngrok tunnel is fine for local
# testing but is NOT valid for a real deployment: once deployed, set this
# to your actual production domain, e.g. https://yourapp.vercel.app
MPESA_CALLBACK_URL=

# Public site URL used to build absolute links in outgoing emails (e.g. the
# listing reactivation "Activate" link -- see lib/actions/maintenance.ts).
# Same value as MPESA_CALLBACK_URL above once deployed.
APP_URL=
